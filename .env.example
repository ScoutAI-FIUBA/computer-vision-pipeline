# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# For Modal these same values are supplied as Secrets, not as a .env file.
# See SETUP.md for the `modal secret create` commands.

# ===== Roboflow (required) =====
ROBOFLOW_API_KEY=
# Override only if you are pointing at a self-hosted inference server.
ROBOFLOW_API_URL=https://serverless.roboflow.com
PLAYER_MODEL_ID=basketball-player-detection-3-ycjdo/16
SHOT_MODEL_ID=basketball-player-detection-3-ycjdo/1
SHOT_TARGET_FPS=
COURT_MODEL_ID=basketball-court-detection-2/22
JERSEY_OCR_MODEL_ID=

# ===== SAM2 =====
# COST: hiera-small is the default. hiera-large is noticeably better and
# noticeably more expensive — the image encoder runs on every frame.
# Options: facebook/sam2-hiera-tiny | -small | -large
SAM2_MODEL_ID=facebook/sam2-hiera-small

# ===== Cloudflare R2 (only needed when reading/writing job artifacts) =====
# Same bucket and credentials the Render backend uses.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# ===== Modal web endpoint auth =====
# Shared bearer token. The Render backend will send this; the Modal endpoint
# rejects anything else. Generate with: openssl rand -hex 32
MODAL_WEBHOOK_TOKEN=
